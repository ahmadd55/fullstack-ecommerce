# ---------------------------------------------------------------------------
# Local development
# ---------------------------------------------------------------------------
PORT=3000

# Individual connection settings, used when DATABASE_URL is not set.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ecommerce
DB_USER=postgres
DB_PASSWORD=your_password

# ---------------------------------------------------------------------------
# Production
# ---------------------------------------------------------------------------
# Hosted Postgres (Neon, Supabase, Render) hands you a single connection string.
# When this is set it overrides all DB_* values above and enables SSL.
# On Neon or Supabase use the POOLED connection string, not the direct one --
# serverless functions open far more connections than a direct endpoint allows.
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Set to true only if your Postgres needs SSL but you are not using DATABASE_URL.
# DB_SSL=true

# Signing key for JWTs. Use a long random string; never reuse the local one.
JWT_SECRET_KEY=replace_with_a_long_random_string

# ---------------------------------------------------------------------------
# Image storage (Cloudinary)
# ---------------------------------------------------------------------------
# Product images and profile pictures are uploaded here instead of local disk,
# because serverless hosts have no persistent filesystem.
# Find these on your Cloudinary dashboard under Account Details.
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ---------------------------------------------------------------------------
# CORS
# ---------------------------------------------------------------------------
# Comma-separated list of frontend origins allowed to call this API.
# http://localhost:5173 is always allowed and does not need to be listed.
CORS_ORIGINS=https://your-frontend.vercel.app

# Allow every *.vercel.app preview deployment to call this API. Handy while
# testing branch deploys, but it opens the API to any Vercel-hosted site.
ALLOW_VERCEL_PREVIEWS=false
