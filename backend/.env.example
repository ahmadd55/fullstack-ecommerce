# Copy this file to .env and fill in your own values.
# The frontend expects the API on port 3000 (see frontend/src/api/axios.js).

PORT=3000

DB_HOST=localhost
DB_PORT=5432
DB_NAME=ecommerce
DB_USER=postgres
DB_PASSWORD=

# Use a long random string. Tokens are signed and verified with this key.
JWT_SECRET_KEY=
